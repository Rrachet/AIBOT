# Supabase project settings
# Get these from Supabase Dashboard -> Connect
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret. NEVER expose this to the browser.
SUPABASE_SECRET_KEY=

# Optional. Origin used to build the signup confirmation link, e.g.
# https://aibot.example.com. Derived from the request when unset, which is
# what you want locally and on preview deployments.
NEXT_PUBLIC_SITE_URL=

# Voice provider - configure when a provider is selected
VOICE_PROVIDER=
VOICE_API_KEY=
VOICE_FROM_NUMBER=

# WhatsApp provider - future phase
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# AI provider - future phase
AI_PROVIDER=
AI_API_KEY=

# Speech provider. Unset (or 'demo') previews a call by reading it aloud with
# the voices already installed on the viewer's own machine - no account, no key
# and no request leaves the browser. Any other value is an explicit request for
# a hosted voice and fails until one is implemented.
SPEECH_PROVIDER=

# Workspace capabilities.
#
# Workspace ids - not emails, not names - allowed to hear a test call read
# aloud. Comma or whitespace separated. Unset means nobody, which is correct
# for every deployment that is not the demo. A name would be the wrong key: any
# owner can edit it from Settings, so granting on one would let a workspace
# grant itself the capability.
LIVE_VOICE_PREVIEW_WORKSPACE_IDS=
